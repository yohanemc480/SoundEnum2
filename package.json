{
  "name": "sound-enum",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.node.json",
    "test": "node --import ./tools/register_css_tests.mjs --test tools/test_*.mjs",
    "verify:data": "node tools/verify_search_data.mjs",
    "build": "npm run typecheck && vite build && node tools/copy_static_resources.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 8000 --strictPort",
    "check:pages-size": "node tools/check_pages_size.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vanilla-extract/css": "^1.21.3",
    "@vanilla-extract/vite-plugin": "^5.2.6",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}
